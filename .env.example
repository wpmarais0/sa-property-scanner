# =============================================================================
# Database
# =============================================================================
# Use SQLite for local dev (zero config):
DATABASE_URL=sqlite:///./properties.db
# Use PostgreSQL for production (Neon, Supabase, local Docker):
# DATABASE_URL=postgresql+asyncpg://scanner:scanner@localhost:5432/properties

# =============================================================================
# Notifications (at least one is required)
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=

# =============================================================================
# Source Configuration
# =============================================================================
PROPERTY24_ENABLED=true
PROPERTY24_SEARCH_URL=https://www.property24.com/for-sale/western-cape/9

PRIVATE_PROPERTY_ENABLED=true
PRIVATE_PROPERTY_SEARCH_URL=https://www.privateproperty.co.za/houses-for-sale/western-cape/4

PAM_GOLDING_ENABLED=true
PAM_GOLDING_SEARCH_URL=https://www.pamgolding.co.za/property-search/properties-for-sale

SEEFF_ENABLED=true
SEEFF_SEARCH_URL=https://www.seeff.com/results/residential/for-sale

SOTHEBYS_ENABLED=true
SOTHEBYS_SEARCH_URL=https://www.sothebysrealty.co.za/results/residential/for-sale/all/all/?advanced_search=11b9b16c-b873-5633-a96d-084bf6acc0d9&area__province__in__or=3

JUST_PROPERTY_ENABLED=true
JUST_PROPERTY_SEARCH_URL=https://www.just.property/results/residential/for-sale/all/all/?advanced_search=b72036b6-13d0-5186-b872-dc411d74e2ab&area__province__in__or=3

HARCOURTS_ENABLED=true
HARCOURTS_SEARCH_URL=https://www.harcourts.co.za/results/residential/for-sale/all/all/?advanced_search=b72036b6-13d0-5186-b872-dc411d74e2ab&area__province__in__or=3

RAWSON_ENABLED=true
RAWSON_SEARCH_URL=https://rawson.co.za/property/for-sale

# =============================================================================
# Filtering
# =============================================================================
MIN_PRICE=1300000
MAX_PRICE=2300000
BEDROOMS_MIN=2
BEDROOMS_MAX=3
BATHROOMS_MIN=1
BATHROOMS_MAX=
GARAGE_MIN=
PET_FRIENDLY=true
OWN_YARD=true
FIBRE_INTERNET=false
PROPERTY_TYPES=house

# Location filtering - restrict to Western Cape towns only
WESTERN_CAPE_ONLY=true

# =============================================================================
# Pagination
# =============================================================================
PAGINATION_MAX_PAGES=3

# =============================================================================
# Scraping Behaviour
# =============================================================================
SLEEP_BETWEEN_REQUESTS=2
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
MAX_RETRIES=3

# =============================================================================
# Monitoring (optional)
# =============================================================================
# HEALTHCHECKS_URL=https://hc-ping.com/your-uuid-here
